# Copy to .env (install.sh does this) and fill in. .env is never committed.

# The write reviewer's LLM. "openai" works with any OpenAI-compatible API; or "anthropic".
LLM_PROVIDER=anthropic
LLM_API_KEY=
LLM_MODEL=claude-haiku-5-5
# LLM_BASE_URL=https://api.openai.com/v1

# Service
MEMORY_HOST=127.0.0.1
MEMORY_PORT=8000
MEMORY_LANG=en
# MEMORY_DB=data/memory.db
# AGENTS_FILE=config/agents.json
